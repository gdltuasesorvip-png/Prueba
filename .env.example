# Clave de API de Anthropic (necesaria para la extracción automática de PDFs)
ANTHROPIC_API_KEY=sk-ant-...

# Clave secreta para firmar las sesiones. Cámbiala por una cadena larga y aleatoria.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Usuario administrador inicial (solo se usa si la base de datos está vacía)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar123
ADMIN_NAME=Administrador

# Dónde guardar la base de datos y los PDFs subidos
DATA_DIR=./data

# Modelo de Claude usado para leer las cotizaciones
CLAUDE_MODEL=claude-opus-5-5
